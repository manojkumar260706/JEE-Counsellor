# Server Configuration
PORT=8080

# Active Spring Profile (e.g., dev, prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jee_counsellor
DB_USER=postgres
DB_PASSWORD=postgres

# Hibernate DDL Auto (e.g., update, create-drop, validate, none)
DDL_AUTO=update
SHOW_SQL=true
